# ==============================================================================
# Go4Guru Platform — Environment Configuration Template (Phase 0 Foundation)
# Copy to .env for local development. NEVER commit .env or real secrets.
# ==============================================================================

# --- Core Runtime ---
APP_NAME=go4guru-api
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Network & CORS ---
API_HOST=127.0.0.1
API_PORT=8000
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
TRUSTED_HOSTS=["localhost","127.0.0.1"]

# --- Primary Database (PostgreSQL 18 + pgvector) ---
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_LOCAL_DB_PASSWORD@127.0.0.1:5432/go4guru
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# --- Cache, Queue & PubSub (Redis) ---
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=2.0

# --- Object Storage (S3-Compatible / MinIO) ---
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=CHANGE_ME_MINIO_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_SECRET_KEY
S3_PRIVATE_BUCKET=go4guru-private

# --- Authentication & Security Baseline ---
JWT_SECRET_KEY=CHANGE_ME_GENERATE_AT_LEAST_32_CHARS_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_ARGON2_TIME_COST=3
PASSWORD_ARGON2_MEMORY_COST=65536
PASSWORD_ARGON2_PARALLELISM=2

# --- External Providers (Future Phases — Keep Blank Until Enabled) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
SENTRY_DSN=

# --- Frontend Web App (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_BASE_URL=ws://127.0.0.1:8000
NEXT_PUBLIC_APP_ENV=development
